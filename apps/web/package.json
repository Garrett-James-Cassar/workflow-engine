{
  "name": "@workflow-engine/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_MODE=mock vite",
    "dev:demo": "VITE_MODE=demo vite",
    "dev:live": "VITE_MODE=live vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "check:bundle": "node scripts/check-bundle.mjs",
    "preview": "vite preview --port 5183 --strictPort",
    "gen:api": "openapi-typescript contract/openapi.yaml -o src/api/generated/schema.d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p cypress/tsconfig.json --noEmit",
    "cy:run": "node scripts/cypress.mjs --coverage",
    "cy:smoke": "node scripts/cypress.mjs --smoke",
    "cy:coverage": "node scripts/cypress.mjs --coverage",
    "cy:demo": "node scripts/cypress.mjs --demo",
    "cy:unreachable": "node scripts/cypress.mjs --unreachable",
    "cy:live": "node scripts/cypress.mjs --live",
    "test": "vitest run",
    "lint": "node scripts/check-style.mjs",
    "gen:check": "pnpm gen:api && git diff --exit-code -- src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.1.0",
    "@fontsource/hanken-grotesk": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "ag-grid-community": "33.0.4",
    "ag-grid-react": "33.0.4",
    "chai": "^4.5.0",
    "clsx": "^2.1.1",
    "jquery": "^3.7.1",
    "lucide-react": "^0.460.0",
    "mermaid": "11.4.1",
    "openapi-fetch": "^0.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.13.0",
    "@types/chai": "^4.3.0",
    "@types/jquery": "^3.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.0",
    "axe-core": "^4.10.0",
    "cypress": "^13.15.0",
    "cypress-axe": "^1.5.0",
    "cypress-real-events": "1.13.0",
    "msw": "^2.6.0",
    "nyc": "^17.1.0",
    "openapi-typescript": "^7.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-istanbul": "^6.0.2",
    "vitest": "^2.1.0",
    "yaml": "^2.6.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "pnpm": {
    "overrides": {
      "dompurify": ">=3.4.17",
      "lodash-es": ">=4.18.0",
      "js-yaml@4": ">=4.3.2"
    }
  }
}
