<?xml version="1.0" encoding="UTF-8"?>
<!--
  stdout: ECS JSON through Boot's structured encoder (format, service.* and the customizer come from
  logging.structured in application.yaml). Plus the OpenTelemetry appender: with OTEL_EXPORTER_OTLP_ENDPOINT
  set, every line is ALSO exported as an OTLP log record with the active trace_id and span_id, so Grafana links
  a Tempo trace to its Loki lines. LogExport hands the appender the SDK; with no endpoint nothing is exported
  and stdout is unchanged (OBSERVABILITY.md section 2).
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
      <format>${CONSOLE_LOG_STRUCTURED_FORMAT}</format>
      <charset>${CONSOLE_LOG_CHARSET}</charset>
    </encoder>
  </appender>
  <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
    <captureKeyValuePairAttributes>true</captureKeyValuePairAttributes>
    <captureMdcAttributes>labels.endpoint,event.action,labels.origin</captureMdcAttributes>
  </appender>
  <!-- Every record goes through here: it adds labels.endpoint, event.action and labels.origin (the process phase
       when no request or job is in flight) before stdout and OTLP see it. -->
  <appender name="LABELLED" class="dev.workflow.app.config.LabelledAppender">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="OTEL"/>
  </appender>
  <root level="INFO">
    <appender-ref ref="LABELLED"/>
  </root>
</configuration>
