  "coverage": {
    "admin": "e.admin (engine-admin, everything); ops.admin (tasks.reassign via ops)",
    "read-only": "r.viewer (auditor: workflows.read, instances.read, tasks.read; no write permission)",
    "denied": "p.maint (no grants; /check says why; the 403-with-reason is proven in AuthorizationTest 'a denied person gets 403 with the reason...' and '...cannot start a run')",
